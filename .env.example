# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Used for absolute URLs (SEO / Open Graph). Set to your Vercel URL after deploy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Brevo (free plan) – emails you every contact-form message. Server-side only.
# API key: Brevo → profile menu → SMTP & API → API Keys → Generate a new API key
BREVO_API_KEY=
# Must be a verified sender in Brevo (Senders, Domains & Dedicated IPs → Senders)
BREVO_SENDER_EMAIL=you@gmail.com
BREVO_SENDER_NAME=Portfolio Contact Form
# Where notifications go (defaults to BREVO_SENDER_EMAIL)
CONTACT_NOTIFY_EMAIL=you@gmail.com
